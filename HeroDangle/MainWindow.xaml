<Window x:Class="HeroDangle.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="HeroDangle"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        Focusable="False"
        PreviewMouseLeftButtonDown="OnPreviewMouseDown"
        PreviewMouseMove="OnPreviewMouseMove"
        PreviewMouseLeftButtonUp="OnPreviewMouseUp"
        PreviewMouseRightButtonUp="OnPreviewMouseRightButtonUp">
    <skia:SKElement x:Name="Skia"
                    IgnorePixelScaling="True"
                    PaintSurface="OnPaintSurface"/>
</Window>
