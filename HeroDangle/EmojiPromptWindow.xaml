<Window x:Class="HeroDangle.EmojiPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom emoji"
        Width="320"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FFF7F4EE">
    <StackPanel Margin="16">
        <TextBlock Margin="0,0,0,8" Text="Paste or type an emoji"/>
        <TextBox x:Name="EmojiBox" FontSize="28" Padding="8" MaxLength="8"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Use" Width="80" IsDefault="True" Click="OnUse"/>
        </StackPanel>
    </StackPanel>
</Window>
